DB_NAME=books
DB_USER=books
DB_PASSWORD=books
DB_HOST=localhost
DB_PORT=5432

API_PORT=3001
WEB_PORT=3000
API_BASE_PATH=/api/v1

MINIO_IMAGE=quay.io/minio/aistor/minio:latest
MINIO_ROOT_USER=books-minio
MINIO_ROOT_PASSWORD=change-admin-password
MINIO_LICENSE_PATH=./minio.license
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=books-development
S3_ACCESS_KEY_ID=books-api
S3_SECRET_ACCESS_KEY=change-api-password
S3_PUBLIC_BASE_URL=http://localhost:9000/books-development
S3_FORCE_PATH_STYLE=true
S3_MAX_FILE_SIZE=5242880

VITE_API_MOCKING=false
VITE_MOCK_JWT_SECRET=change-me
