{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir ../.. api:generate && vite",
    "build": "pnpm --dir ../.. api:generate && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "check-types": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format:check": "prettier --check .",
    "api:generate": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@books/api-contract": "workspace:*",
    "@lucide/vue": "^1.47.0",
    "@tanstack/vue-query": "^5.103.2",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "jose": "^6.2.12",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@books/eslint-config": "workspace:*",
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query-devtools": "^6.2.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "jiti": "^2.7.0",
    "msw": "^2.15.0",
    "npm-run-all2": "^9.0.3",
    "orval": "^8.33.0",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
