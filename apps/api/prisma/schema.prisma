generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model authors {
  id           Int            @id @default(autoincrement())
  full_name    String
  book_authors book_authors[]

  @@index([full_name])
}

model book_authors {
  book_id   Int
  author_id Int
  authors   authors @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  books     books   @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([book_id, author_id])
  @@index([author_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model books {
  id              Int            @id @default(autoincrement())
  title           String
  year            Int
  description     String
  isbn            String
  cover_key       String?
  cover_mime_type String?
  cover_size      Int?
  cover_etag      String?
  book_authors    book_authors[]

  @@index([isbn])
  @@index([title])
  @@index([year])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username       String           @unique
  email          String           @unique
  password       String
  role           String           @default("user")
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  refresh_tokens refresh_tokens[]
}

model refresh_tokens {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id     String          @db.Uuid
  user_id        String          @db.Uuid
  token_hash     String          @unique
  expires_at     DateTime        @db.Timestamptz(6)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  used_at        DateTime?       @db.Timestamptz(6)
  revoked_at     DateTime?       @db.Timestamptz(6)
  replaced_by_id String?         @unique @db.Uuid
  users          users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  replaced_by    refresh_tokens? @relation("refresh_rotation", fields: [replaced_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replaces       refresh_tokens? @relation("refresh_rotation")

  @@index([session_id])
  @@index([user_id])
  @@index([expires_at])
}
