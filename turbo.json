{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".prettierignore", "prettier.config.mjs"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format:check": {
      "dependsOn": ["^format:check"]
    }
  }
}
